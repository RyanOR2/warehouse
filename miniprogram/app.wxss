/**app.wxss**/
page {
  background: #f3f4f6;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  font-size: 28rpx;
  color: #1f2937;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

/* ===== 通用卡片 ===== */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

/* ===== 按钮 ===== */
.btn-primary {
  background: #f5a623;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 2.6;
  text-align: center;
}

.btn-primary[disabled] {
  background: #e5d6b8;
  color: #ffffff;
}

.btn-plain {
  background: #ffffff;
  color: #6b7280;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 2.4;
  text-align: center;
}

.btn-danger {
  background: #ffffff;
  color: #ef4444;
  border: 1rpx solid #ef4444;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 2.4;
  text-align: center;
}

/* ===== 表单 ===== */
.form-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.form-label .required {
  color: #ef4444;
}

.form-input {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 30rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.form-picker {
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 30rpx;
  color: #1f2937;
}

.form-picker.placeholder {
  color: #9ca3af;
}

/* ===== 状态标签 ===== */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.tag-green {
  color: #16a34a;
  background: rgba(22, 163, 74, 0.1);
}

.tag-orange {
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.12);
}

.tag-red {
  color: #ef4444;
  background: rgba(239, 68, 68, 0.1);
}

.tag-gray {
  color: #6b7280;
  background: #f3f4f6;
}

/* ===== 文字辅助 ===== */
.text-secondary {
  color: #6b7280;
}

.text-danger {
  color: #ef4444;
}

.text-green {
  color: #16a34a;
}

.text-orange {
  color: #f59e0b;
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 80rpx 0;
}

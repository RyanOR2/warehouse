/* pages/orders/index.wxss */
.page {
  padding: 24rpx;
}

.filter-row {
  margin-bottom: 16rpx;
}

.filter-picker {
  display: inline-block;
  background: #ffffff;
  border-radius: 10rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #1f2937;
}

.order-card {
  margin: 16rpx 0;
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.order-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.order-customer {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #1f2937;
}

.order-items {
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f3f4f6;
}

.order-item {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #1f2937;
  padding: 4rpx 0;
}

.oi-qty {
  color: #6b7280;
}

.order-remark {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.order-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}

.order-count {
  font-size: 24rpx;
  color: #6b7280;
}

.order-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #f5a623;
}

.order-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  margin: 0;
  font-size: 28rpx;
  line-height: 2.4;
}

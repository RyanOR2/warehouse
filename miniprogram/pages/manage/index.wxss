/* pages/manage/index.wxss */
.page {
  padding: 24rpx;
}

.toolbar {
  margin-bottom: 16rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 8rpx 8rpx 8rpx 20rpx;
  margin-bottom: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-btn {
  color: #f5a623;
  font-size: 28rpx;
  padding: 12rpx 20rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.filter-picker {
  background: #ffffff;
  border-radius: 10rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  color: #1f2937;
}

.filter-picker.placeholder {
  color: #9ca3af;
}

.clear-filter {
  font-size: 24rpx;
  color: #6b7280;
}

.toolbar-link {
  font-size: 26rpx;
  color: #6b7280;
  margin-left: auto;
}

.toolbar-link.primary {
  color: #f5a623;
  font-weight: 500;
}

.beer-card {
  margin: 16rpx 0;
}

.beer-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.beer-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.beer-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.beer-metrics {
  display: flex;
  margin-top: 24rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f3f4f6;
  border-bottom: 1rpx solid #f3f4f6;
}

.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.metric-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.beer-actions {
  display: flex;
  justify-content: flex-end;
  gap: 32rpx;
  margin-top: 20rpx;
}

.action-link {
  font-size: 26rpx;
  color: #6b7280;
}

.action-link.danger {
  color: #ef4444;
}

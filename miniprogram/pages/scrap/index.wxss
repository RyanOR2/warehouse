/* pages/scrap/index.wxss */
.page {
  padding: 24rpx;
}

.save-btn {
  margin-top: 16rpx;
}

.batch-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.batch-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.batch-tip {
  font-size: 22rpx;
  color: #9ca3af;
}

.batch-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.batch-item:last-child {
  border-bottom: none;
}

.batch-info {
  flex: 1;
}

.batch-dates {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.batch-stock {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #1f2937;
}

.radio {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 50%;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #ffffff;
  flex-shrink: 0;
}

.radio.checked {
  background: #f5a623;
  border-color: #f5a623;
}

.scrap-form {
  margin-top: 20rpx;
}

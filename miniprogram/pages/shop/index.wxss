/* pages/shop/index.wxss */
.page {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

.beer-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #f7b733, #f5a623);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
  position: relative;
  box-shadow: 0 6rpx 20rpx rgba(245, 166, 35, 0.3);
}

.banner-icon {
  font-size: 76rpx;
  line-height: 1;
  margin-right: 24rpx;
}

.banner-text {
  flex: 1;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 700;
}

.banner-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

.cart-entry {
  position: relative;
  font-size: 48rpx;
  padding: 8rpx 4rpx;
}

.cart-badge {
  position: absolute;
  top: -2rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #ef4444;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 20rpx;
}

.cat-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.cat-chip {
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  font-size: 26rpx;
  color: #6b7280;
}

.cat-chip.active {
  background: #f5a623;
  color: #ffffff;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.goods-card {
  width: 48.5%;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.goods-icon {
  height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.goods-icon text {
  font-size: 88rpx;
  line-height: 1;
}

.goods-img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 12rpx;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9ca3af;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.goods-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #f5a623;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.step-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  background: #f3f4f6;
  color: #1f2937;
  border-radius: 50%;
  font-size: 32rpx;
}

.step-btn.step-add {
  background: #f5a623;
  color: #ffffff;
}

.step-num {
  min-width: 36rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

<!--pages/cart/index.wxml-->
<view class="page">
  <view wx:if="{{!cart.length}}" class="empty">购物车是空的，快去逛逛吧</view>

  <view class="cart-list" wx:else>
    <view class="cart-item" wx:for="{{cart}}" wx:key="beerId">
      <view class="item-icon">
        <image wx:if="{{item.image}}" class="item-img" src="{{item.image}}" mode="aspectFill" />
        <text wx:else>{{item.icon}}</text>
      </view>
      <view class="item-info">
        <view class="item-name">{{item.name}}</view>
        <view class="item-price">¥{{item.priceText}} / 瓶</view>
      </view>
      <view class="stepper">
        <view class="step-btn" data-id="{{item.beerId}}" bindtap="onMinus">−</view>
        <view class="step-num">{{item.quantity}}</view>
        <view class="step-btn" data-id="{{item.beerId}}" bindtap="onPlus">＋</view>
      </view>
      <view class="item-del" data-id="{{item.beerId}}" bindtap="onDelete">🗑</view>
    </view>
  </view>

  <view class="checkout-bar" wx:if="{{cart.length}}">
    <view class="checkout-total">
      <text class="total-label">合计</text>
      <text class="total-price">¥{{totalAmountText}}</text>
    </view>
    <button class="btn-primary checkout-btn" bindtap="onCheckout">去结算</button>
  </view>

  <view class="modal-mask" wx:if="{{showCheckout}}" bindtap="onCloseCheckout"></view>
  <view class="modal-body" wx:if="{{showCheckout}}">
    <view class="modal-title">确认下单</view>
    <view class="form-item">
      <view class="form-label"><text class="required">*</text> 联系人</view>
      <input class="form-input" placeholder="请输入姓名" value="{{form.customerName}}" data-field="customerName" bindinput="onInput" />
    </view>
    <view class="form-item">
      <view class="form-label"><text class="required">*</text> 联系电话</view>
      <input class="form-input" type="number" placeholder="请输入手机号" value="{{form.customerPhone}}" data-field="customerPhone" bindinput="onInput" />
    </view>
    <view class="form-item">
      <view class="form-label">备注</view>
      <input class="form-input" placeholder="选填，如配送/自提说明" value="{{form.remark}}" data-field="remark" bindinput="onInput" />
    </view>
    <view class="modal-total">
      <text class="total-label">合计</text>
      <text class="total-price">¥{{totalAmountText}}</text>
    </view>
    <view class="modal-actions">
      <view class="btn-plain modal-btn" hover-class="btn-hover" bindtap="onCloseCheckout">取消</view>
      <view class="btn-primary modal-btn" hover-class="btn-hover" bindtap="onSubmit">结算</view>
    </view>
  </view>
</view>

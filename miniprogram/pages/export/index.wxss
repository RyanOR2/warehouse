/* pages/export/index.wxss */
.page {
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin: 24rpx 8rpx 16rpx;
}

.target-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.target-item {
  width: calc(50% - 10rpx);
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.target-active {
  border-color: #f5a623;
  background: rgba(245, 166, 35, 0.06);
}

.target-icon {
  font-size: 56rpx;
  line-height: 1;
}

.target-label {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 500;
}

.card {
  margin: 24rpx 0;
}

.export-btn {
  margin: 24rpx 0 8rpx;
}

.export-tip {
  font-size: 22rpx;
  color: #9ca3af;
  text-align: center;
  margin-top: 8rpx;
}

/* pages/my-orders/index.wxss */
.page {
  padding: 24rpx;
}

.order-card {
  margin: 16rpx 0;
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.order-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.order-items {
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f3f4f6;
}

.order-item {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #1f2937;
  padding: 4rpx 0;
}

.oi-qty {
  color: #6b7280;
}

.order-remark {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.order-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}

.order-count {
  font-size: 24rpx;
  color: #6b7280;
}

.order-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #f5a623;
}

.load-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #9ca3af;
}

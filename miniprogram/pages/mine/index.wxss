/* pages/mine/index.wxss */
.page {
  padding: 24rpx;
}

.profile-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #f7b733, #f5a623);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(245, 166, 35, 0.3);
}

.avatar {
  font-size: 80rpx;
  line-height: 1;
  margin-right: 24rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

.admin-panel {
  margin: 24rpx 0;
}

.admin-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.quota-line {
  font-size: 22rpx;
  color: #f5a623;
  background: rgba(245, 166, 35, 0.08);
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  margin-bottom: 24rpx;
}

.admin-grid {
  display: flex;
  flex-wrap: wrap;
}

.admin-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.admin-icon {
  font-size: 56rpx;
  line-height: 1;
}

.admin-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24rpx 8rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.view-all {
  font-size: 24rpx;
  color: #f5a623;
}

.join-panel {
  margin: 24rpx 0;
}

.join-btn {
  background: rgba(245, 166, 35, 0.1);
  color: #f5a623;
  border-radius: 12rpx;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 500;
}

.order-card {
  margin: 16rpx 0;
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.order-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.order-items {
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f3f4f6;
}

.order-item {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #1f2937;
  padding: 4rpx 0;
}

.oi-qty {
  color: #6b7280;
}

.order-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}

.order-count {
  font-size: 24rpx;
  color: #6b7280;
}

.order-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #f5a623;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  width: 80%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  text-align: center;
  margin-bottom: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.modal-btn {
  flex: 1;
  margin: 0;
}

/* pages/statistics/index.wxss */
.seg-tabs {
  display: flex;
  background: #e5e7eb;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.seg-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  border-radius: 8rpx;
}

.seg-tab.active {
  background: #ffffff;
  color: #f5a623;
  font-weight: 600;
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.summary-cell {
  flex: 1;
  min-width: calc(50% - 10rpx);
  background: #ffffff;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
}

.summary-label {
  font-size: 24rpx;
  color: #6b7280;
}

.summary-value {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
}

.summary-value.profit {
  color: #3b82f6;
}

.summary-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #6b7280;
}

.chart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.gran-tabs {
  display: flex;
  gap: 8rpx;
}

.gran-tab {
  padding: 6rpx 18rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-radius: 8rpx;
}

.gran-tab.active {
  color: #ffffff;
  background: #f5a623;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-no {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.rank-item:first-child .rank-no {
  background: #f5a623;
  color: #ffffff;
}

.rank-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.rank-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.rank-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.rank-right {
  text-align: right;
  margin-left: 16rpx;
}

.rank-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
}

.rank-profit {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #3b82f6;
}
